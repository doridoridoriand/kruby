require "bundler/gem_tasks"
require "shellwords"

require_relative "spec/support/changed_spec_selector"

begin
  require 'rspec/core/rake_task'

  RSpec::Core::RakeTask.new(:spec)
  task default: :spec
rescue LoadError
  # no rspec available
end

e2e_scripts_dir = File.expand_path('../scripts/e2e', __dir__)
release_scripts_dir = File.expand_path('../scripts/release', __dir__)

run_script = lambda do |script_name, env = {}, *args|
  script_path = File.join(e2e_scripts_dir, script_name)
  raise "missing script: #{script_path}" unless File.executable?(script_path)

  success = system(env, script_path, *args)
  command_display = ([script_path] + args).join(' ')
  raise "command failed: #{command_display}" unless success
end

run_release_script = lambda do |script_name, *args|
  script_path = File.join(release_scripts_dir, script_name)
  raise "missing script: #{script_path}" unless File.executable?(script_path)

  success = system(script_path, *args)
  command_display = Shellwords.join([script_path] + args)
  raise "command failed: #{command_display}" unless success
end

spec_glob_pattern = lambda do |entry|
  entry.match?(/[*?\[\]{}]/)
end

run_specs = lambda do |specs|
  require "rspec/core"

  selected_specs = Array(specs).flat_map do |entry|
    if File.directory?(entry)
      Dir.glob(File.join(entry, "**/*_spec.rb"))
    elsif spec_glob_pattern.call(entry)
      Dir.glob(entry)
    elsif File.exist?(entry)
      [entry]
    else
      raise ArgumentError, "spec entry not found: #{entry}"
    end
  end.uniq.sort

  abort("no specs selected") if selected_specs.empty?

  status = RSpec::Core::Runner.run(selected_specs)
  raise "RSpec failed with exit code #{status}" unless status.zero?
end

unit_specs = %w[
  spec/api_error_spec.rb
  spec/config/config_error_spec.rb
  spec/config/incluster_config_spec.rb
  spec/config/kube_config_spec.rb
  spec/configuration_spec.rb
  spec/loader_spec.rb
  spec/models/serialization_spec.rb
  spec/models/smoke_spec.rb
  spec/release/changelog_spec.rb
  spec/release/publish_guard_spec.rb
  spec/support/e2e/coverage_gate_spec.rb
  spec/support/e2e/coverage_inventory_spec.rb
  spec/utils_spec.rb
  spec/version_spec.rb
].freeze

integration_specs = %w[
  spec/api_client_spec.rb
  spec/auth_spec.rb
  spec/custom_objects_api_spec.rb
  spec/discovery_api_spec.rb
  spec/logs_api_spec.rb
  spec/release/publish_script_spec.rb
  spec/version_api_spec.rb
  spec/watch_spec.rb
  spec/well_known_api_spec.rb
].freeze

smoke_specs = SpecSupport::ChangedSpecSelector::DEFAULT_SMOKE_SPECS.freeze

desc "Run fast library-focused specs"
task "spec:unit" do
  run_specs.call(unit_specs)
end

desc "Run offline client and generated API integration specs"
task "spec:integration" do
  run_specs.call(integration_specs)
end

desc "Run the compact smoke suite for everyday development"
task "spec:smoke" do
  run_specs.call(smoke_specs)
end

desc "Run E2E-related specs without requiring a live cluster"
task "spec:e2e" do
  run_specs.call(["spec/e2e"])
end

desc 'Run only specs impacted by the current diff: rake "spec:changed[origin/master]"'
task "spec:changed", [:base_ref] do |_task, args|
  base_ref = args[:base_ref].to_s.strip
  base_ref = ENV["BASE_REF"].to_s.strip if base_ref.empty?
  base_ref = SpecSupport::ChangedSpecSelector::DEFAULT_BASE_REF if base_ref.empty?

  selection = SpecSupport::ChangedSpecSelector.new.resolve(base_ref: base_ref)
  puts "Selected specs (base=#{selection.base_ref}, fallback=#{selection.fallback_used}):"
  selection.selected_specs.each { |spec| puts "  - #{spec}" }
  puts "Reason: #{selection.reason}" if selection.reason

  run_specs.call(selection.selected_specs)
end

namespace :e2e do
  desc 'Run full kind-backed E2E suite (set E2E_KUBERNETES_VERSION=1.31..1.36 to choose the Kind version)'
  task :full, [:fallback] do |_task, args|
    fallback = args[:fallback].to_s.strip
    fallback = ENV['E2E_FALLBACK_STRATEGY'].to_s.strip if fallback.empty?
    fallback = 'minimal-smoke' if fallback.empty?

    run_script.call('run-e2e', {}, '--mode', 'full', '--fallback', fallback)
  end

  desc 'Run targeted E2E selectors: rake "e2e:targeted[core/v1/pods:create]"'
  task :targeted, [:targets] do |_task, args|
    targets = args[:targets].to_s.strip
    targets = ENV['E2E_TARGETS'].to_s.strip if targets.empty?
    abort('E2E target selectors are required via task arg or E2E_TARGETS env var') if targets.empty?

    run_script.call('run-e2e', {}, '--mode', 'targeted', '--targets', targets)
  end

  desc 'Run changed-only E2E selectors: rake "e2e:changed[origin/HEAD]"'
  task :changed, [:base_ref] do |_task, args|
    base_ref = args[:base_ref].to_s.strip
    base_ref = ENV['BASE_REF'].to_s.strip if base_ref.empty?
    base_ref = 'origin/HEAD' if base_ref.empty?

    run_script.call('run-e2e', {}, '--mode', 'changed', '--base-ref', base_ref)
  end

  desc 'Map changed files to selectors: rake "e2e:map_changes[origin/HEAD]"'
  task :map_changes, [:base_ref] do |_task, args|
    base_ref = args[:base_ref].to_s.strip
    base_ref = ENV['BASE_REF'].to_s.strip if base_ref.empty?
    base_ref = 'origin/HEAD' if base_ref.empty?

    run_script.call('map-changes', {}, '--base-ref', base_ref)
  end

  desc 'Print baseline minimal-smoke selectors'
  task :list_targets do
    smoke_file = File.expand_path('spec/support/e2e/smoke_targets.yml', __dir__)
    unless File.exist?(smoke_file)
      abort("missing smoke target file: #{smoke_file}")
    end

    puts File.read(smoke_file)
  end

  desc 'Verify gem package excludes spec/test/features/docs'
  task :package_guard do
    run_script.call('check-gem-package')
  end

  desc 'Run a multi-version Kind matrix in parallel (set E2E_KUBERNETES_VERSIONS=1.31,1.32,... to override)'
  task :matrix, [:versions] do |_task, args|
    versions = args[:versions].to_s.strip
    versions = ENV['E2E_KUBERNETES_VERSIONS'].to_s.strip if versions.empty?

    command_args = ['--mode', 'full']
    command_args += ['--versions', versions] unless versions.empty?
    run_script.call('run-e2e-matrix', {}, *command_args)
  end

  desc 'Generate API coverage inventory: rake "e2e:coverage_inventory[specs/002-real-api-e2e-coverage/coverage_inventory.json]"'
  task :coverage_inventory, [:output, :policy] do |_task, args|
    output = args[:output].to_s.strip
    output = ENV['E2E_COVERAGE_OUTPUT'].to_s.strip if output.empty?
    output = 'specs/002-real-api-e2e-coverage/coverage_inventory.json' if output.empty?

    policy = args[:policy].to_s.strip
    policy = ENV['E2E_COVERAGE_POLICY'].to_s.strip if policy.empty?

    command_args = ['--output', output]
    command_args += ['--policy', policy] unless policy.empty?
    run_script.call('generate-coverage-inventory', {}, *command_args)
  end
end

namespace :release do
  desc 'Validate CHANGELOG.md and version metadata for a release'
  task :check, [:version] do |_task, args|
    version = args[:version].to_s.strip
    command_args = ['--require-empty-unreleased']
    command_args += ['--version', version] unless version.empty?
    run_release_script.call('check', *command_args)
  end

  desc 'Print release notes for the given version or current gem version'
  task :notes, [:version] do |_task, args|
    version = args[:version].to_s.strip
    command_args = []
    command_args += ['--version', version] unless version.empty?
    run_release_script.call('notes', *command_args)
  end

  desc 'Create an annotated git tag for the current gem version'
  task :tag do
    run_release_script.call('tag')
  end

  desc 'Validate and build the current release gem without publishing'
  task :publish_dry_run do
    run_release_script.call('publish', '--dry-run')
  end

  desc 'Publish the current release gem to RubyGems'
  task :publish do
    run_release_script.call('publish')
  end
end

Rake::Task['release'].clear if Rake::Task.task_defined?('release')

desc 'Validate release metadata and create an annotated git tag'
task release: 'release:tag'
